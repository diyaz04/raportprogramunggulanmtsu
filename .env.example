# Salin menjadi .env.local (atau .env) lalu isi dari Supabase Dashboard > Project Settings > API Keys.
# Hanya kunci PUBLISHABLE (sb_publishable_...) yang boleh dipakai di NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# OPSIONAL (hanya server): untuk tombol "Buat akun" & reset kata sandi di menu Guru & Akun.
# Kunci ini melewati RLS. JANGAN diberi awalan NEXT_PUBLIC_ dan jangan dibagikan.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
